# 复制为 .env 后使用：make genenv（自动生成随机 API_KEY）或手动 cp
# 必填！部署时改为强随机值。make up 启动时会校验：未设置或仍是 change-me 直接拒绝启动
API_KEY=change-me
AUTH_ENABLED=true
TORCH_THREADS=4
# YOLO 检测置信度下限（低于此值不返回）
MIN_CONF=0.25
# 裁剪边距比例（相对框尺寸）
CROP_PAD=0.05
# 按框中心取方形裁剪（true：避免 DINOv2 resize 拉伸变形）
SQUARE_CROP=true
# 请求图片大小上限（字节，默认 20MB）
MAX_IMAGE_BYTES=20971520
# 以下为构建期/本地专用变量，镜像运行时无需设置（Dockerfile 已烘焙进 ENV）：
#   HF_ENDPOINT=https://hf-mirror.com   （构建期下载模型用，运行时 HF_HUB_OFFLINE=1 完全离线）
#   FEATURE_MODEL=models/dinov2         （模型路径，镜像内已固定）
#   YOLO_WEIGHTS=models/yolov8n.pt      （同上）
# 仅当本地 uv run 调试需覆盖路径/镜像时，取消注释使用。
